<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net472;net48;net8.0-windows;net10.0-windows</TargetFrameworks>
		<IsPackable>false</IsPackable>
		<Platforms>AnyCPU</Platforms>
		<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
		<RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>
		<Configurations>Debug;Release;netstandard</Configurations>
		<EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
		<!-- These are integration tests against a shared MIM service, and every fixture starts by
		     deleting all test objects. Concurrent target-framework runs destroy each other's
		     fixtures, so dotnet test must run the frameworks sequentially, as Visual Studio does. -->
		<TestTfmsInParallel>false</TestTfmsInParallel>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
		<!-- Supplies the .NET Framework reference assemblies for the net472/net48
		     targets, so they build on machines without the targeting packs
		     installed (such as the lab test agent). -->
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="nunit" Version="3.13.3" />
		<PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
		<PackageReference Include="MSTest.TestFramework" Version="4.2.3" />
		<PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.9" />
		<PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.9" />
	</ItemGroup>

	<ItemGroup Condition="$(Configuration) == 'netstandard'">
		<ProjectReference Include="..\Lithnet.ResourceManagement.Client\Lithnet.ResourceManagement.Client.csproj">
			<SetTargetFramework>TargetFramework=netstandard2.0</SetTargetFramework>
		</ProjectReference>
		<PackageReference Include="System.Security.Principal.Windows" Version="5.0.0" />
	</ItemGroup>
	
	<ItemGroup Condition="$(Configuration) != 'netstandard'">
		<ProjectReference Include="..\Lithnet.ResourceManagement.Client\Lithnet.ResourceManagement.Client.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<Target Name="CopyAppConfig" AfterTargets="PostBuildEvent" Condition="$(TargetFrameworkIdentifier) == '.NETFramework'">
		<CreateItem Include="$(TargetPath).config">
			<Output TaskParameter="Include" ItemName="FilesToCopy" />
		</CreateItem>
		<Copy SourceFiles="@(FilesToCopy)" DestinationFiles="$(OutputPath)testhost.dll.config" />
	</Target>

</Project>
